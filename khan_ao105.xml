        <updated>2024-11-19T03:26:48.195Z</updated>
        <content type="html"><![CDATA[<div class="thumb">
                                        <picture>
                                            <source type="image/webp" srcset="https://img.khan.co.kr/news/c/190x140/2024/06/25/l_2024062601000742300076452.webp" loading="lazy">
